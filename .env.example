# Copy this file to .env.local for local testing with `npm run dev` or `vercel dev`.
# Never commit .env.local or real API keys to git.

GEMINI_API_KEY=
# Primary model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=
# Comma-separated fallback models tried on 429/503 (defaults to gemini-3.1-flash-lite,gemini-3.5-flash)
GEMINI_FALLBACK_MODELS=
# Optional per-attempt timeout in ms (defaults to 30000, total cap ~40s)
GEMINI_TIMEOUT_MS=
